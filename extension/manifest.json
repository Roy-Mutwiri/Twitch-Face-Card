{
  "manifest_version": 3,
  "name": "FaceFrame Bridge",
  "version": "1.1.0",
  "description": "Sends the selected webcam area of a playing video element to the local FaceFrame app (127.0.0.1 only). Activated per tab by clicking the toolbar button.",
  "key": "",
  "minimum_chrome_version": "116",
  "action": { "default_title": "FaceFrame Bridge", "default_popup": "popup.html" },
  "background": { "service_worker": "sw.js" },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "web_accessible_resources": [
    { "resources": ["bridge.html", "bridge.js"], "matches": ["https://*/*"], "use_dynamic_url": true }
  ]
}
